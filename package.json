{
	"name": "scaleofdeaths",
	"version": "1.0.0",
	"description": "The true scale of human deaths in wars, epidemics, disasters and other events - one dot per 1,000 lives.",
	"license": "PolyForm-Noncommercial-1.0.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.13",
	"engines": {
		"bun": ">=1.3"
	},
	"scripts": {
		"dev": "vite",
		"build": "bun scripts/build.ts",
		"preview": "vite preview --port 4173 --strictPort",
		"validate": "bun scripts/validate.ts",
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"check:size": "bun scripts/check-size.ts",
		"check:links": "bun scripts/check-links.ts",
		"check:lighthouse": "bun scripts/check-lighthouse.ts",
		"make:og": "bun scripts/make-og.ts",
		"check": "bun run validate && bun run lint && bun run typecheck && bun run test && bun run build && bun run check:size && bun run test:e2e && bun run check:lighthouse"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@biomejs/biome": "^2.6.2",
		"@playwright/test": "^1.64.1",
		"@types/node": "^26.6.5",
		"chrome-launcher": "^1.2.2",
		"esbuild": "^0.28.2",
		"lighthouse": "^13.5.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	}
}
